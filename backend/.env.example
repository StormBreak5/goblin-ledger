BLIZZARD_CLIENT_ID="seu-cliente-aqui"
BLIZZARD_CLIENT_SECRET="seu-segredo-aqui"
DB_HOST="db"
DB_USER="goblin"
DB_PASS="goblin_password"
DB_NAME="goblinledger"

# CU09 – ingestão de dados de mercado (API oficial da Blizzard, de 60 em 60 minutos)
# Reinos conectados monitorados, no formato regiao:id separados por vírgula. Só US e EU são aceitas (RN11); as
# commodities de cada região presente entram automaticamente. Padrão: us:3209 (Azralon).
MONITORED_REALMS="us:3209"
# Proporção de registros descartados por lote acima da qual o lote vai para o log de auditoria (CU09-C2-FA1).
INGESTAO_LIMITE_DESCARTE=0.05
# Dias em que os leilões Expirado/Vendido continuam no banco; o resumo horário do histórico permanece.
INGESTAO_RETENCAO_LEILOES_DIAS=7
# Volume anômalo (RN12): mais de N vezes a mediana dos últimos 7 dias, com um piso de volume.
INGESTAO_ANOMALIA_FATOR=10
INGESTAO_ANOMALIA_VOLUME_MINIMO=100

# CU01/CU02 – autenticação
# Segredo do JWT (mínimo 32 caracteres). Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ele a API usa um segredo efêmero e as sessões se perdem a cada reinício.
JWT_SECRET=""
# Mínimo de caracteres da senha (o documento do TC não define a regra).
PASSWORD_MIN_LENGTH=8
# Custo do bcrypt.
BCRYPT_ROUNDS=12

# CU02-C2 – e-mail de recuperação de senha. Os padrões abaixo funcionam com o Mailpit do docker-compose
# (mensagens em http://localhost:8025). Em produção, aponte para um SMTP real.
FRONTEND_URL="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="nao-responda@goblinledger.local"
SMTP_STARTTLS=false

# CU10-C1 – importação do histórico de preços (Undermine Exchange)
# RN23: intervalo mínimo, em segundos, entre o início de duas requisições à fonte. O padrão (0.008, cerca de 125
# requisições por segundo) é o ritmo que a importação já tinha; aumente se a fonte pedir mais cuidado.
UNDERMINE_INTERVALO_MINIMO_SEGUNDOS=0.008
# FE1: quantas falhas seguidas (rede, tempo limite, 429 ou 5xx) interrompem a importação como "fonte indisponível".
IMPORTACAO_LIMITE_FALHAS_SEGUIDAS=20
# FE3: quantos arquivos seguidos que não decodificam interrompem a importação como "formato alterado".
IMPORTACAO_LIMITE_ARQUIVOS_ILEGIVEIS=3

# CU10-C2 – eventos de atualização do jogo (RN17)
# Os eventos sazonais e as regras de calendário são gerados do ano em que o histórico começa até N anos à frente.
EVENTOS_ANO_INICIAL=2022
EVENTOS_ANOS_A_FRENTE=1
# Reinício semanal da Europa (o autor só informou o dos EUA: terça-feira às 7:00 PDT). Sugestão: wednesday; "off" desliga.
EVENTOS_REINICIO_SEMANAL_EU=wednesday
# Intervalo mínimo, em minutos, para ler de novo a mesma página de referência (Wikipedia, Warcraft Wiki).
EVENTOS_INTERVALO_MINIMO_MINUTOS=10
# Contato opcional que vai no User-Agent das leituras (e-mail ou endereço do projeto), para quem mantém as páginas.
EVENTOS_CONTATO=

BLIZZARD_CLIENT_ID="seu-cliente-aqui"
BLIZZARD_CLIENT_SECRET="seu-segredo-aqui"
DB_HOST="db"
DB_USER="goblin"
DB_PASS="goblin_password"
DB_NAME="goblinledger"

# CU09 – ingestão de dados de mercado (API oficial da Blizzard, de 60 em 60 minutos)
# Reinos conectados monitorados, no formato regiao:id separados por vírgula. Só US e EU são aceitas (RN11); as
# commodities de cada região presente entram automaticamente. Padrão: us:3209 (Azralon).
MONITORED_REALMS="us:3209"
# Proporção de registros descartados por lote acima da qual o lote vai para o log de auditoria (CU09-C2-FA1).
INGESTAO_LIMITE_DESCARTE=0.05
# Dias em que os leilões Expirado/Vendido continuam no banco; o resumo horário do histórico permanece.
INGESTAO_RETENCAO_LEILOES_DIAS=7
# Volume anômalo (RN12): mais de N vezes a mediana dos últimos 7 dias, com um piso de volume.
INGESTAO_ANOMALIA_FATOR=10
INGESTAO_ANOMALIA_VOLUME_MINIMO=100

# CU01/CU02 – autenticação
# Segredo do JWT (mínimo 32 caracteres). Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem ele a API usa um segredo efêmero e as sessões se perdem a cada reinício.
JWT_SECRET=""
# Mínimo de caracteres da senha (o documento do TC não define a regra).
PASSWORD_MIN_LENGTH=8
# Custo do bcrypt.
BCRYPT_ROUNDS=12

# CU02-C2 – e-mail de recuperação de senha. Os padrões abaixo funcionam com o Mailpit do docker-compose
# (mensagens em http://localhost:8025). Em produção, aponte para um SMTP real.
FRONTEND_URL="http://localhost:3000"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="nao-responda@goblinledger.local"
SMTP_STARTTLS=false

# CU10-C1 – importação do histórico de preços (Undermine Exchange)
# RN23: intervalo mínimo, em segundos, entre o início de duas requisições à fonte. O padrão (0.008, cerca de 125
# requisições por segundo) é o ritmo que a importação já tinha; aumente se a fonte pedir mais cuidado.
UNDERMINE_INTERVALO_MINIMO_SEGUNDOS=0.008
# FE1: quantas falhas seguidas (rede, tempo limite, 429 ou 5xx) interrompem a importação como "fonte indisponível".
IMPORTACAO_LIMITE_FALHAS_SEGUIDAS=20
# FE3: quantos arquivos seguidos que não decodificam interrompem a importação como "formato alterado".
IMPORTACAO_LIMITE_ARQUIVOS_ILEGIVEIS=3
# Importação diária (incremental) da série da Undermine, no formato crontab e em UTC; "off" desliga. Padrão: 02:00 UTC.
HISTORICO_IMPORTACAO_DIARIA_CRON=0 2 * * *

# CU10-C2 – eventos de atualização do jogo (RN17)
# Os eventos sazonais e as regras de calendário são gerados do ano em que o histórico começa até N anos à frente.
EVENTOS_ANO_INICIAL=2022
EVENTOS_ANOS_A_FRENTE=1
# Reinício semanal da Europa (o autor só informou o dos EUA: terça-feira às 7:00 PDT). Sugestão: wednesday; "off" desliga.
EVENTOS_REINICIO_SEMANAL_EU=wednesday
# Intervalo mínimo, em minutos, para ler de novo a mesma página de referência (Wikipedia, Warcraft Wiki).
EVENTOS_INTERVALO_MINIMO_MINUTOS=10
# Contato opcional que vai no User-Agent das leituras (e-mail ou endereço do projeto), para quem mantém as páginas.
EVENTOS_CONTATO=

# CU10-C3 – cobertura histórica (RN15)
# Período contínuo mínimo, em dias, para o treinamento inicial (6 meses).
COBERTURA_MINIMO_DIAS=180
# Dias seguidos sem registro que ainda não interrompem o período ("desconsiderando lacunas na série"; sugestão: 3).
COBERTURA_LACUNA_MAXIMA_DIAS=3

# CU04-C1-FA1 (RN09) – "Dados Desatualizados": idade, em horas, do último ciclo de ingestão do mercado do item a partir da qual
# a tela avisa (o documento não define o limiar; sugestão original: 2).
DADOS_DESATUALIZADOS_HORAS=24

# CU05-C1-FA7 – "Projeção desatualizada": dias que o dia de referência da projeção pode ficar atrás do último dia encerrado.
PROJECAO_DESATUALIZADA_DIAS=2

# CU06-C3 – variação do dia anterior na lista de favoritos: o ponto do ciclo de 24 h antes do valor atual só vale se
# estiver a no máximo estas horas dele (sem ele, a variação fica "—").
FAVORITOS_VARIACAO_TOLERANCIA_HORAS=2

# CU11 – modelo preditivo global (serviço `modelo` do docker-compose). Os padrões são a configuração final do estudo
# (estudos/lstm/, etapa 2e) e os valores decididos na v4; vazio = padrão.
# Pasta dos artefatos de cada versão (modelos/v{versao}); o docker-compose usa /app/modelos.
MODELO_PASTA=
# De quanto em quanto tempo, em segundos, o serviço consulta a fila de treinamentos.
MODELO_INTERVALO_FILA_SEGUNDOS=10
# CU11-C1-FA2: um treinamento "em andamento" há mais horas que isso (o processo parou) deixa de bloquear os novos.
MODELO_TEMPO_MAXIMO_HORAS=6
# Formato das amostras e normalização (RF12, RF04, RN24, RN25); histórico mínimo para projeção (RN27).
MODELO_JANELA_DIAS=30
MODELO_HORIZONTE_DIAS=7
MODELO_ZSCORE_DIAS=90
MODELO_HISTORICO_MINIMO_DIAS=60
# RN25 (decidido): divisão 70/20/10 por data; o teste fica com o restante.
MODELO_PROPORCAO_TREINO=0.70
MODELO_PROPORCAO_VALIDACAO=0.20
MODELO_ANTECEDENCIA_PATCH_DIAS=14
# RN03 (decidido): registros seguidos que confirmam um novo patamar; salto absurdo e a confirmação exigida nele.
MODELO_RN03_CONFIRMACAO=7
MODELO_RN03_SALTO_ABSURDO=1000
MODELO_RN03_CONFIRMACAO_ABSURDO=28
# RN10 (decidido): MdAPE de no máximo 15%, menor que o do ingênuo, com ao menos 30 dias avaliados.
MODELO_METRICA_RN10=mdape
MODELO_LIMIAR_RN10=0.15
MODELO_MINIMO_DIAS_RN10=30
# Rede e treino (decidido na etapa 2e). MODELO_PERDA: mae (decidido), huber ou mse.
MODELO_UNIDADES=64
MODELO_PERDA=mae
MODELO_EPOCAS_MAX=100
MODELO_PACIENCIA=10
MODELO_LOTE=512
MODELO_AMOSTRAS_POR_EPOCA=400000
# Amostra fixa da validação usada na parada antecipada.
MODELO_AMOSTRAS_VALIDACAO=200000
MODELO_SEMENTE=42
# CU11-C2: retreinamento semanal, no formato crontab e em UTC ("off" desliga). Use o NOME do dia da semana: no
# APScheduler 3, o número 2 seria quarta-feira. Padrão: terça às 18:00 UTC, depois do reinício semanal dos EUA.
MODELO_RETREINO_CRON=0 18 * * tue
# Aviso "série diária desatualizada" no resumo quando o último dia encerrado da série tem mais que estes dias.
MODELO_SERIE_DESATUALIZADA_DIAS=3
# CU11-C3: consolidação diária das predições, no formato crontab e em UTC ("off" desliga). Padrão: 03:00 UTC, uma hora
# depois da importação diária do worker.
MODELO_CONSOLIDACAO_CRON=0 3 * * *
# Quantos minutos a consolidação espera a importação diária de hoje terminar (ou começar) antes de seguir com aviso.
MODELO_CONSOLIDACAO_ESPERA_MINUTOS=60
# RN13 / C3-FA3: mediana do erro dos últimos N dias, com ao menos M erros avaliados, acima do limiar da RN10.
MODELO_DEGRADACAO_DIAS=7
MODELO_DEGRADACAO_MINIMO_ALVOS=14
# C3-FA4: fração dos itens liberados bloqueados por degradação no dia que antecipa o retreinamento.
MODELO_DEGRADACAO_GERAL=0.20
# C3 passo 7: dias de histórico lidos para as previsões (janela + padronização de 90 dias + aquecimento da RN03).
MODELO_PREVISAO_HISTORICO_DIAS=200
# Opções reprovadas no estudo (etapa 2b): só "false" é aceito, o sistema não tem a outra opção.
MODELO_MASCARA=false
MODELO_EVENTOS_DETALHADOS=false
